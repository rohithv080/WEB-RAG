generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Site {
  id               String        @id @default(cuid())
  name             String? // display name for the bot card
  description      String? // short blurb shown on the card
  systemPrompt     String? // custom persona/instructions for the LLM
  starterQuestions Json? // list of clickable starter prompts ["Question 1", "Question 2"]
  tone             String?       @default("balanced") // "concise" | "balanced" | "detailed"
  userId           String? // owner user id for multi-tenancy / Clerk Auth
  isPublic         Boolean       @default(true) // public or private bot
  scrapedAt        DateTime      @default(now())
  pages            Page[]
  sessions         ChatSession[]

  @@index([userId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  scrapedAt DateTime @default(now())
  chunks    Chunk[]

  @@index([siteId])
}

model Chunk {
  id            String                     @id @default(cuid())
  pageId        String
  page          Page                       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content       String
  heading       String? // nearest h2/h3 for better citations
  order         Int // position in doc
  isBoilerplate Boolean                    @default(false)
  embedding     Unsupported("vector(768)") // nomic-embed-text-v1 is 768-dim
  tsv           Unsupported("tsvector")?

  @@index([pageId])
}

model ChatSession {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())

  @@index([siteId])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  citations Json? // [{ chunkId, heading, snippet, pageUrl }]
  rating    String? // "up" | "down"
  feedback  String? // optional comment
  latencyMs Int? // generation latency in ms
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([role])
}

model TelegramState {
  chatId    BigInt  @id
  siteId    String?
  sessionId String?
  language  String?
}
