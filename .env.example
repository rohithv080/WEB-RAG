# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional; default openai/gpt-oss-20b (llama-3.3-70b-versatile may be unavailable)
GROQ_MODEL=openai/gpt-oss-20b

# PostgreSQL with pgvector extension
# Example: postgresql://user:password@localhost:5432/web_rag?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/web_rag?schema=public

# Admin gate for write actions (POST/PATCH /api/scrape).
# Omit or leave empty to disable the gate in dev. Set a strong secret for production.
ADMIN_SECRET=

# Optional: Free-tier Clerk Authentication (https://dashboard.clerk.com)
# When set, enables multi-user login, user profiles, and private bots.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
